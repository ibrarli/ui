{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Strictness */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* Path Mapping */
    "baseUrl": ".",
    "paths": {
      "@apen-ui/core": ["../../packages/ui/src/index.ts"],
      "@apen-ui/core/*": ["../../packages/ui/src/*"]
    }
  },
  /* ADD THE PATH TO YOUR LIBRARY SOURCE HERE */
  "include": [
    "src", 
    "../../packages/ui/src/**/*.ts", 
    "../../packages/ui/src/**/*.tsx"
  ]
}