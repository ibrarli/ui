{
  "name": "apen-ui-monorepo",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter www dev",
    "build": "pnpm registry:build && pnpm --filter apen-ui build && pnpm --filter www build",
    "registry:build": "node packages/ui/scripts/build-registry.mjs",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm --filter www lint",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1"
  }
}
