{
  "name": "apen-ui",
  "version": "0.1.0",
  "description": "Add rounded, dashboard-ready Apen UI components to your project. Copy the code, own the code. By Apen Apps.",
  "type": "module",
  "bin": {
    "apen-ui": "./dist/index.js"
  },
  "files": [
    "dist",
    "registry",
    "schema.json",
    "banner.svg"
  ],
  "scripts": {
    "build": "node ../ui/scripts/build-registry.mjs && tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && node test/smoke.mjs",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "apen",
    "apen-ui",
    "components",
    "react",
    "tailwindcss",
    "radix-ui",
    "shadcn",
    "dashboard",
    "cli"
  ],
  "author": "Apen Apps (https://www.apenapps.com)",
  "license": "MIT",
  "homepage": "https://github.com/ibrarli/apen-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ibrarli/apen-ui.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/ibrarli/apen-ui/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/prompts": "^2.4.9",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  }
}
